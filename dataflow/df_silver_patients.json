{
	"name": "df_silver_patients",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_Patients",
						"type": "DatasetReference"
					},
					"name": "Patients"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_patients",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Patients",
				"Patients derive(patient_id = trim(patient_id),",
				"          gender = iif(\r",
				"    upper(trim(coalesce(gender, ''))) == 'M' ||\r",
				"    upper(trim(coalesce(gender, ''))) == 'MALE',\r",
				"    'M',\r",
				"    iif(\r",
				"        upper(trim(coalesce(gender, ''))) == 'F' ||\r",
				"        upper(trim(coalesce(gender, ''))) == 'FEMALE',\r",
				"        'F',\r",
				"        'DESCONOCIDO'\r",
				"    )\r",
				"),",
				"          phone = iif(\r",
				"    isNull(phone) ||\r",
				"    lower(trim(phone)) == 'unknown' ||\r",
				"    trim(phone) == '',\r",
				"    toString(null()),\r",
				"    trim(phone)\r",
				"),",
				"          email = iif(\r",
				"    isNull(email) || trim(email) == '',\r",
				"    toString(null()),\r",
				"    regexReplace(\r",
				"        lower(trim(email)),\r",
				"        `@gmial\\.com$`,\r",
				"        '@gmail.com'\r",
				"    )\r",
				"),",
				"          address = trim(address),",
				"          insurance_provider = upper(trim(insurance_provider)),",
				"          date_of_birth = trim(date_of_birth),",
				"          full_name = regexReplace(trim(full_name),  `\\s+` , ' '),",
				"          date_of_birth_parsed = iif(\r",
				"    isDate(trim(date_of_birth), 'yyyy-MM-dd'),\r",
				"    toDate(trim(date_of_birth), 'yyyy-MM-dd'),\r",
				"    iif(\r",
				"        isDate(trim(date_of_birth), 'MMMM dd, yyyy'),\r",
				"        toDate(trim(date_of_birth), 'MMMM dd, yyyy'),\r",
				"        iif(\r",
				"            isDate(trim(date_of_birth), 'dd-MMM-yyyy'),\r",
				"            toDate(trim(date_of_birth), 'dd-MMM-yyyy'),\r",
				"            iif(\r",
				"                isDate(trim(date_of_birth), 'MM/dd/yyyy'),\r",
				"                toDate(trim(date_of_birth), 'MM/dd/yyyy'),\r",
				"                toDate(null())\r",
				"            )\r",
				"        )\r",
				"    )\r",
				"),",
				"          phone_digits = iif(     isNull(phone) ||     lower(trim(phone)) == 'unknown' ||     trim(phone) == '',     toString(null()),     regexReplace(trim(phone), `[^0-9]`, '') )) ~> derivedColumn1",
				"derivedColumn1 derive(email_status = iif(\r",
				"    isNull(email) || trim(email) == '',\r",
				"    'SIN_EMAIL',\r",
				"    iif(\r",
				"        regexMatch(\r",
				"            trim(email),\r",
				"            `^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$`\r",
				"        ),\r",
				"        'FORMATO_OK',\r",
				"        'REVISAR'\r",
				"    )\r",
				"),",
				"          phone_status = iif(     isNull(phone_digits) || phone_digits == '',     'SIN_TELEFONO',     iif(         length(phone_digits) == 10 || length(phone_digits) == 11,         'FORMATO_COMPATIBLE',         'REVISAR'     ) ),",
				"          date_status = iif(     isNull(date_of_birth_parsed),     'REVISAR_FECHA',     'CONVERTIDA' )) ~> derivedColumn2",
				"derivedColumn2 filter(!isNull(patient_id) &&",
				"isInteger(trim(patient_id)) &&",
				"!isNull(full_name) &&",
				"length(trim(full_name)) > 0) ~> filter1",
				"filter1 derive(patient_id = toInteger(patient_id)) ~> derivedColumn3",
				"derivedColumn3 alterRow(insertIf(true())) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['patient_id'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth = date_of_birth_parsed,",
				"          phone = phone_digits,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     )) ~> sink1"
			]
		}
	}
}