{
	"name": "df_gold_dim_departamento",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Silver_admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "ds_gold_departamento",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_gold_departamento",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(nombre_departamento = \r",
				"case(\r",
				"    upper(trim(department)) == 'CARDIO' ||\r",
				"    upper(trim(department)) == 'CARDIOLGY' ||\r",
				"    upper(trim(department)) == 'CARDIOLOGY',\r",
				"    'CARDIOLOGY',\r",
				"\r",
				"    upper(trim(department)) == 'EMERGANCY' ||\r",
				"    upper(trim(department)) == 'EMERGENCY',\r",
				"    'EMERGENCY',\r",
				"\r",
				"    upper(trim(department)) == 'NEURO' ||\r",
				"    upper(trim(department)) == 'NUEROLOGY' ||\r",
				"    upper(trim(department)) == 'NEUROLOGY',\r",
				"    'NEUROLOGY',\r",
				"\r",
				"    upper(trim(department)) == 'ONCOLOGY' ||\r",
				"    upper(trim(department)) == 'ONCOLOGYY',\r",
				"    'ONCOLOGY',\r",
				"\r",
				"    upper(trim(department)) == 'ORTHO' ||\r",
				"    upper(trim(department)) == 'ORTHOPAEDICS' ||\r",
				"    upper(trim(department)) == 'ORTHOPEDICS',\r",
				"    'ORTHOPEDICS',\r",
				"\r",
				"    upper(trim(department)) == 'PEDS' ||\r",
				"    upper(trim(department)) == 'PEDIATRICS',\r",
				"    'PEDIATRICS',\r",
				"\r",
				"    upper(trim(department))\r",
				")\r",
				") ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(nombre_departamento) &&",
				"length(trim(nombre_departamento)) > 0) ~> filter1",
				"filter1 aggregate(groupBy(nombre_departamento),",
				"     total_admisiones = count()) ~> aggregate1",
				"aggregate1, source2 exists(aggregate1@nombre_departamento == source2@nombre_departamento,",
				"     negate:true,",
				"     broadcast: 'auto')~> exists1",
				"exists1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          nombre_departamento",
				"     )) ~> sink1"
			]
		}
	}
}