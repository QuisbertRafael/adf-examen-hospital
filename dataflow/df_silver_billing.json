{
	"name": "df_silver_billing",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_Billing",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DS_Silver_admissions",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_billing",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(billing_id = trim(billing_id),",
				"          admission_id = trim(admission_id),",
				"          charge_type = upper(trim(charge_type)),",
				"          payment_status = upper(trim(payment_status)),",
				"          amount_clean = iif(\r",
				"    isNull(amount) || trim(amount) == '',\r",
				"    toString(null()),\r",
				"    trim(\r",
				"        replace(\r",
				"            replace(\r",
				"                replace(\r",
				"                    upper(trim(amount)),\r",
				"                    'USD',\r",
				"                    ''\r",
				"                ),\r",
				"                '$',\r",
				"                ''\r",
				"            ),\r",
				"            ',',\r",
				"            ''\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn1",
				"derivedColumn1 derive(amount_status = case(\r",
				"    isNull(amount_clean),\r",
				"    'REVISAR_MONTO',\r",
				"\r",
				"    isDecimal(amount_clean),\r",
				"    'MONTO_VALIDO',\r",
				"\r",
				"    'REVISAR_MONTO'\r",
				"),",
				"          payment_date_parsed = case(\r",
				"    isNull(payment_date) || trim(payment_date) == '',\r",
				"    toDate(null()),\r",
				"\r",
				"    regexMatch(trim(payment_date), `^[0-9]{2}-[0-9]{2}-[0-9]{2}$`),\r",
				"    toDate(\r",
				"        concat(\r",
				"            '20',\r",
				"            right(trim(payment_date), 2),\r",
				"            '-',\r",
				"            left(trim(payment_date), 2),\r",
				"            '-',\r",
				"            substring(trim(payment_date), 4, 2)\r",
				"        ),\r",
				"        'yyyy-MM-dd'\r",
				"    ),\r",
				"\r",
				"    regexMatch(trim(payment_date), `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`),\r",
				"    toDate(trim(payment_date), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(trim(payment_date), `^[0-9]{2}/[0-9]{2}/[0-9]{4}$`),\r",
				"    toDate(trim(payment_date), 'MM/dd/yyyy'),\r",
				"\r",
				"    isDate(trim(payment_date), 'dd-MMM-yyyy'),\r",
				"    toDate(trim(payment_date), 'dd-MMM-yyyy'),\r",
				"\r",
				"    isDate(trim(payment_date), 'MMMM dd, yyyy'),\r",
				"    toDate(trim(payment_date), 'MMMM dd, yyyy'),\r",
				"\r",
				"    toDate(null())\r",
				")) ~> derivedColumn2",
				"derivedColumn2 filter(!isNull(billing_id) &&",
				"isInteger(trim(billing_id)) &&",
				"!isNull(admission_id) &&",
				"isInteger(trim(admission_id)) &&",
				"amount_status == 'MONTO_VALIDO' &&",
				"!isNull(charge_type) &&",
				"length(trim(charge_type)) > 0 &&",
				"!isNull(payment_status) &&",
				"length(trim(payment_status)) > 0 &&",
				"(",
				"    isNull(payment_date) ||",
				"    trim(payment_date) == '' ||",
				"    !isNull(payment_date_parsed)",
				")) ~> filter1",
				"filter1 derive(billing_id = toInteger(billing_id),",
				"          admission_id = toInteger(admission_id),",
				"          amount_decimal = toDecimal(amount_clean, 12, 2)) ~> derivedColumn3",
				"exists1 alterRow(upsertIf(true())) ~> alterRow1",
				"derivedColumn3, source2 exists(derivedColumn3@admission_id == source2@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['billing_id'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount = amount_decimal,",
				"          payment_status,",
				"          payment_date = payment_date_parsed",
				"     )) ~> sink1"
			]
		}
	}
}