{
	"name": "df_silver_admissions",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_Admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DS_Silver_patients",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_admissions",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(admission_id = trim(admission_id),",
				"          patient_id = trim(patient_id),",
				"          attending_doctor_id = trim(attending_doctor_id),",
				"          department = case(\r",
				"    upper(trim(department)) == 'ONCO' ||\r",
				"    upper(trim(department)) == 'ONCOLOGY' ||\r",
				"    upper(trim(department)) == 'ONCOLOWV',\r",
				"    'ONCOLOGY',\r",
				"\r",
				"    upper(trim(department)) == 'CARDIOLOV',\r",
				"    'CARDIOLOGY',\r",
				"\r",
				"    upper(trim(department)) == 'ER' ||\r",
				"    upper(trim(department)) == 'EMERGENCY',\r",
				"    'EMERGENCY',\r",
				"\r",
				"    upper(trim(department)) == 'GEN SURG' ||\r",
				"    upper(trim(department)) == 'GENERALSURGERY',\r",
				"    'GENERAL SURGERY',\r",
				"\r",
				"    upper(trim(department)) == 'PAEDIATRICS',\r",
				"    'PEDIATRICS',\r",
				"\r",
				"    upper(trim(department)) == 'NEUROLOAV',\r",
				"    'NEUROLOGY',\r",
				"\r",
				"    upper(trim(department))\r",
				"),",
				"          admission_date = case(\r",
				"    isDate(trim(admission_date), 'yyyy-MM-dd'),\r",
				"    toDate(trim(admission_date), 'yyyy-MM-dd'),\r",
				"\r",
				"    isDate(trim(admission_date), 'dd-MMM-yyyy'),\r",
				"    toDate(trim(admission_date), 'dd-MMM-yyyy'),\r",
				"\r",
				"    isDate(trim(admission_date), 'MMMM dd, yyyy'),\r",
				"    toDate(trim(admission_date), 'MMMM dd, yyyy'),\r",
				"\r",
				"    isDate(trim(admission_date), 'MM/dd/yyyy'),\r",
				"    toDate(trim(admission_date), 'MM/dd/yyyy'),\r",
				"\r",
				"    isDate(trim(admission_date), 'MM-dd-yy'),\r",
				"    toDate(trim(admission_date), 'MM-dd-yy'),\r",
				"\r",
				"    toDate(null())\r",
				"),",
				"          discharge_date_parsed = case(\r",
				"    regexMatch(trim(discharge_date), `^[0-9]{2}-[0-9]{2}-[0-9]{2}$`),\r",
				"    toDate(\r",
				"        concat(\r",
				"            '20',\r",
				"            right(trim(discharge_date), 2),\r",
				"            '-',\r",
				"            left(trim(discharge_date), 2),\r",
				"            '-',\r",
				"            substring(trim(discharge_date), 4, 2)\r",
				"        ),\r",
				"        'yyyy-MM-dd'\r",
				"    ),\r",
				"\r",
				"    isDate(trim(discharge_date), 'yyyy-MM-dd'),\r",
				"    toDate(trim(discharge_date), 'yyyy-MM-dd'),\r",
				"\r",
				"    isDate(trim(discharge_date), 'dd-MMM-yyyy'),\r",
				"    toDate(trim(discharge_date), 'dd-MMM-yyyy'),\r",
				"\r",
				"    isDate(trim(discharge_date), 'MMMM dd, yyyy'),\r",
				"    toDate(trim(discharge_date), 'MMMM dd, yyyy'),\r",
				"\r",
				"    isDate(trim(discharge_date), 'MM/dd/yyyy'),\r",
				"    toDate(trim(discharge_date), 'MM/dd/yyyy'),\r",
				"\r",
				"    toDate(null())\r",
				")) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(admission_id) &&",
				"isInteger(trim(admission_id)) &&",
				"!isNull(patient_id) &&",
				"isInteger(trim(patient_id)) &&",
				"!isNull(attending_doctor_id) &&",
				"isInteger(trim(attending_doctor_id)) &&",
				"!isNull(admission_date) &&",
				"!isNull(department) &&",
				"length(trim(department)) > 0) ~> filter1",
				"filter1 derive(admission_id = toInteger(admission_id),",
				"          patient_id = toInteger(patient_id),",
				"          attending_doctor_id = toInteger(attending_doctor_id)) ~> derivedColumn2",
				"exists1 alterRow(upsertIf(true())) ~> alterRow1",
				"derivedColumn2, source2 exists(derivedColumn2@patient_id == source2@patient_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['admission_id'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id,",
				"          patient_id,",
				"          admission_date,",
				"          discharge_date = discharge_date_parsed,",
				"          department,",
				"          attending_doctor_id",
				"     )) ~> sink1"
			]
		}
	}
}